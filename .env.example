# Copy this file to .env and fill it in.

# Path to the service account JSON key you downloaded from Google Cloud.
# Relative paths are resolved from the MEERKAT folder.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Port the local dashboard listens on.
PORT=3000

# --- Alert tuning ---

# Don't re-fire the same alert more often than this.
ALERT_COOLDOWN_HOURS=6

# --- Traffic spike/drop ---
# Alerts are scaled to how much each site normally fluctuates, not to a fixed
# percentage. Both gates below must trip before anything fires.

# How many standard deviations from the site's own norm counts as unusual.
# 2 = jumpy, 2.5 = balanced, 3 = only genuine outliers.
TRAFFIC_Z_SCORE=2.5

# Absolute floor in sessions. Stops tiny sites alerting on 1 -> 4, which is a
# huge percentage and a huge z-score but still not worth a notification.
TRAFFIC_MIN_ABS_DELTA=8

# Days of history needed before the rule is allowed to speak at all.
TRAFFIC_MIN_DAYS=5

# Fallback percentage, used only for a site so flat it has no measurable
# fluctuation (standard deviation of zero).
TRAFFIC_DEVIATION_PCT=50

# --- GSC clicks collapse ---
# Same two-gate approach against the 7-day click pattern.
GSC_Z_SCORE=2
GSC_MIN_ABS_DELTA=5
GSC_DROP_PCT=50

# Set to 0 to disable macOS notification banners (dashboard banner still shows).
NOTIFY_MACOS=1
